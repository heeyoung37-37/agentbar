+import Foundation
+import SweetCookieKit
+import Testing
+@testable import CodexBarCore
+
+@Suite(.serialized)
+struct ClaudeWebRecoveryPolicyTests {
+    @Test
+    func `permission errors include wrapped Cocoa and POSIX denial`() {
+        #expect(ClaudeWebRecoveryPolicy.isPermissionError(CocoaError(.fileReadNoPermission)))
+        #expect(ClaudeWebRecoveryPolicy.isPermissionError(NSError(domain: NSPOSIXErrorDomain, code: 13)))
+        #expect(ClaudeWebRecoveryPolicy.isPermissionError(NSError(domain: NSPOSIXErrorDomain, code: 1)))
+        let wrapped = NSError(domain: "test", code: 0, userInfo: [
+            NSUnderlyingErrorKey: CocoaError(.fileReadNoPermission),
+        ])
+        #expect(ClaudeWebRecoveryPolicy.isPermissionError(wrapped))
+        #expect(!ClaudeWebRecoveryPolicy.isPermissionError(CocoaError(.fileReadNoSuchFile)))
+        #expect(!ClaudeWebRecoveryPolicy.isPermissionError(URLError(.notConnectedToInternet)))
+    }
+
+    @Test
+    func `retry backs off and remains capped after prolonged failure`() {
+        let error = ClaudeWebAPIFetcher.FetchError.cookieAccessDenied(browser: "Safari")
+        #expect((0...6).map { ClaudeWebRecoveryPolicy.retryDelay(after: error, attempt: $0) } ==
+            [15, 30, 60, 120, 300, 300, 300])
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(after: error, attempt: -1) == 15)
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(after: error, attempt: Int.max) == 300)
+    }
+
+    @Test
+    func `network retries exclude cancellation and slow remote throttling`() {
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(after: URLError(.timedOut), attempt: 0) == 15)
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(after: URLError(.cancelled), attempt: 0) == nil)
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(
+            after: ClaudeWebAPIFetcher.FetchError.serverError(statusCode: 429), attempt: 0) == 300)
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(
+            after: ClaudeWebAPIFetcher.FetchError.cloudflareChallenge, attempt: 0) == 300)
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(
+            after: ClaudeWebAPIFetcher.FetchError.serverError(statusCode: 503), attempt: 1) == 30)
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(
+            after: ClaudeWebAPIFetcher.FetchError.serverError(statusCode: 400), attempt: 0) == nil)
+        #expect(ClaudeWebRecoveryPolicy.retryDelay(after: CancellationError(), attempt: 0) == nil)
+    }
+
+    @Test
+    func `browser denial is not reported as missing login`() {
+        let failure = BrowserCookieError.accessDenied(browser: .safari, details: "private cookie path")
+        let error = self.importError(failure)
+        guard case .cookieAccessDenied(browser: "Safari") = error else {
+            Issue.record("Expected a permission error, got \(String(describing: error))")
+            return
+        }
+        #expect(error?.localizedDescription.contains("Permission required") == true)
+        #expect(error?.localizedDescription.contains("private cookie path") == false)
+    }
+
+    @Test
+    func `missing cookie store and corrupt cookie store stay distinct`() {
+        guard case .noSessionKeyFound = self.importError(
+            BrowserCookieError.notFound(browser: .safari, details: "missing"))
+        else {
+            Issue.record("Expected a missing login")
+            return
+        }
+        guard case .cookieReadFailed(browser: "Safari") = self.importError(
+            BrowserCookieError.loadFailed(browser: .safari, details: "corrupt"))
+        else {
+            Issue.record("Expected an unreadable cookie store")
+            return
+        }
+    }
+
+    @Test
+    func `denied Safari directory is not mistaken for an absent cookie store`() {
+        let error = self.importError(
+            BrowserCookieError.notFound(browser: .safari, details: "hidden by permissions"),
+            accessIssue: .accessDenied)
+        guard case .cookieAccessDenied(browser: "Safari") = error else {
+            Issue.record("Expected a permission error for the hidden cookie directory")
+            return
+        }
+    }
+
+    private func importError(
+        _ failure: Error,
+        accessIssue: BrowserProfileAccessIssue? = nil) -> ClaudeWebAPIFetcher.FetchError?
+    {
+        let detection = BrowserDetection(
+            homeDirectory: "/tmp/agentbar-synthetic-absent-home",
+            cacheTTL: 0,
+            now: Date.init,
+            fileExists: { _ in false },
+            directoryContents: { _ in nil },
+            applicationURLs: { _ in [] },
+            profileAccessIssue: { _ in accessIssue })
+        do {
+            let browserOverride: @Sendable (Browser) throws -> ClaudeWebAPIFetcher.SessionKeyInfo? = { _ in
+                throw failure
+            }
+            _ = try ClaudeWebSessionKeyImport.$browserOverrideForTesting.withValue(browserOverride) {
+                try ClaudeWebAPIFetcher.sessionKeyInfo(browserDetection: detection)
+            }
+            return nil
+        } catch {
+            return error as? ClaudeWebAPIFetcher.FetchError
+        }
+    }
+}
