+    /// Joins two rows independently rendered for different providers (each with
+    /// `forceStackedStyle: true`) into a single stacked status item title. Used by the "Stacked"
+    /// combined-icon style, which shows exactly two providers' own single-line content on top of
+    /// each other instead of switching between them.
+    static func composeStackedProviderRows(
+        top: MenuBarLayoutRenderedTitle,
+        bottom: MenuBarLayoutRenderedTitle,
+        topProviderName: String,
+        bottomProviderName: String)
+        -> MenuBarLayoutRenderedTitle
+    {
+        // A row's own accessibility label only names its provider when the row's configured tokens
+        // happen to include the icon or provider-name token; a preset like Compact Stacked can omit
+        // both, leaving VoiceOver unable to tell which value belongs to which provider. Naming the
+        // provider here, independent of the visible tokens, keeps that identification correct for
+        // every layout, not just the ones that happen to render it.
+        if top.attributedTitle.length == 0 {
+            return self.namingProvider(bottomProviderName, in: bottom)
+        }
+        if bottom.attributedTitle.length == 0 {
+            return self.namingProvider(topProviderName, in: top)
+        }
+
+        let rows = self.alignedQuotaRows(top: top.attributedTitle, bottom: bottom.attributedTitle)
+        let topTitle = rows?.top ?? top.attributedTitle
+        let bottomTitle = rows?.bottom ?? bottom.attributedTitle
+        let result = NSMutableAttributedString(attributedString: topTitle)
+        let breakAttributes = topTitle.attributes(at: topTitle.length - 1, effectiveRange: nil)
+        result.append(NSAttributedString(string: "\n", attributes: breakAttributes))
+        result.append(bottomTitle)
+        let secondLineLabel = L("menu_bar_layout_line", 2)
+        let accessibilityLabel = "\(topProviderName), \(top.accessibilityLabel), " +
+            "\(secondLineLabel), \(bottomProviderName), \(bottom.accessibilityLabel)"
+        return MenuBarLayoutRenderedTitle(
+            attributedTitle: result,
+            accessibilityLabel: accessibilityLabel,
+            leadingIcon: nil,
+            statusImage: nil)
+    }
+
+    /// Two-point gutters and a reserved 100% column keep quota rows compact at every digit count.
+    private static func alignedQuotaRows(
+        top: NSAttributedString,
+        bottom: NSAttributedString) -> (top: NSAttributedString, bottom: NSAttributedString)?
+    {
+        func columns(in title: NSAttributedString) -> [NSAttributedString]? {
+            var values: [NSAttributedString] = []
+            let range = NSRange(location: 0, length: title.length)
+            title.enumerateAttribute(self.quotaColumnKey, in: range) { value, range, _ in
+                if value != nil { values.append(title.attributedSubstring(from: range)) }
+            }
+            return values.count == 3 ? values : nil
+        }
+        guard let topColumns = columns(in: top), let bottomColumns = columns(in: bottom) else { return nil }
+        let nameWidth = ceil(max(topColumns[0].size().width, bottomColumns[0].size().width))
+        func reservedPercentWidth(_ percent: NSAttributedString) -> CGFloat {
+            NSAttributedString(string: "100%", attributes: percent.attributes(at: 0, effectiveRange: nil)).size().width
+        }
+        let percentWidth = ceil(max(reservedPercentWidth(topColumns[1]), reservedPercentWidth(bottomColumns[1])))
+        let percentEnd = nameWidth + 2 + percentWidth
+        func aligned(_ columns: [NSAttributedString]) -> NSAttributedString {
+            let result = NSMutableAttributedString(attributedString: columns[0])
+            let attributes = columns[0].attributes(at: 0, effectiveRange: nil)
+            result.append(NSAttributedString(string: "\t", attributes: attributes))
+            result.append(columns[1])
+            result.append(NSAttributedString(string: "\t", attributes: attributes))
+            result.append(columns[2])
+            let paragraph = (attributes[.paragraphStyle] as? NSParagraphStyle)?.mutableCopy()
+                as? NSMutableParagraphStyle ?? NSMutableParagraphStyle()
+            paragraph.tabStops = [
+                NSTextTab(textAlignment: .right, location: percentEnd, options: [:]),
+                NSTextTab(textAlignment: .left, location: percentEnd + 2, options: [:]),
+            ]
+            result.addAttribute(.paragraphStyle, value: paragraph, range: NSRange(location: 0, length: result.length))
+            return result
+        }
+        return (aligned(topColumns), aligned(bottomColumns))
+    }
+
+    private static func namingProvider(
+        _ providerName: String,
+        in row: MenuBarLayoutRenderedTitle)
+        -> MenuBarLayoutRenderedTitle
+    {
+        MenuBarLayoutRenderedTitle(
+            attributedTitle: row.attributedTitle,
+            accessibilityLabel: "\(providerName), \(row.accessibilityLabel)",
+            leadingIcon: row.leadingIcon,
+            statusImage: row.statusImage)
+    }
