@@ -0,0 +1,62 @@
+import Foundation
+import SweetCookieKit
+
+/// Non-secret classification shared by the browser importer and background recovery.
+public enum ClaudeWebRecoveryPolicy {
+    public static func isPermissionError(_ error: Error) -> Bool {
+        self.isPermissionError(error, depth: 0)
+    }
+
+    private static func isPermissionError(_ error: Error, depth: Int) -> Bool {
+        guard depth < 8 else { return false }
+        if case BrowserCookieError.accessDenied = error { return true }
+        let cocoa = error as NSError
+        if cocoa.domain == NSCocoaErrorDomain, cocoa.code == NSFileReadNoPermissionError { return true }
+        if cocoa.domain == NSPOSIXErrorDomain, cocoa.code == 1 || cocoa.code == 13 { return true }
+        if let underlying = cocoa.userInfo[NSUnderlyingErrorKey] as? Error {
+            return self.isPermissionError(underlying, depth: depth + 1)
+        }
+        return false
+    }
+
+    static func isMissingCookieStore(_ error: Error) -> Bool {
+        if case BrowserCookieError.notFound = error { return true }
+        return (error as NSError).domain == NSCocoaErrorDomain &&
+            (error as NSError).code == NSFileReadNoSuchFileError
+    }
+
+    public static func isCookieAccessFailure(_ error: Error) -> Bool {
+        switch error {
+        case ClaudeWebAPIFetcher.FetchError.cookieAccessDenied,
+             ClaudeWebAPIFetcher.FetchError.cookieReadFailed:
+            true
+        default:
+            false
+        }
+    }
+
+    /// Recheck local sessions quickly after startup; never hammer a remote rate limit or challenge.
+    public static func retryDelay(after error: Error, attempt: Int) -> TimeInterval? {
+        let delays: [TimeInterval] = [15, 30, 60, 120, 300]
+        let delay = delays[min(max(attempt, 0), delays.count - 1)]
+        switch error {
+        case ClaudeWebAPIFetcher.FetchError.noSessionKeyFound,
+             ClaudeWebAPIFetcher.FetchError.invalidSessionKey,
+             ClaudeWebAPIFetcher.FetchError.cookieAccessDenied,
+             ClaudeWebAPIFetcher.FetchError.cookieReadFailed,
+             ClaudeWebAPIFetcher.FetchError.unauthorized:
+            return delay
+        case ClaudeWebAPIFetcher.FetchError.cloudflareChallenge:
+            return 300
+        case let ClaudeWebAPIFetcher.FetchError.serverError(statusCode):
+            return statusCode == 429 ? 300 : (statusCode >= 500 ? delay : nil)
+        case let ClaudeWebAPIFetcher.FetchError.networkError(underlying):
+            return self.retryDelay(after: underlying, attempt: attempt)
+        default:
+            if let urlError = error as? URLError, urlError.code != .cancelled {
+                return delay
+            }
+            return nil
+        }
+    }
+}
