+@MainActor
+@Suite(.serialized)
+struct ClaudeWebAutomaticRecoveryTests {
+    @Test
+    func `recovery coalesces failures and cancels on success and disable`() throws {
+        let (context, root) = try self.makeContext()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let runtime = ClaudeProviderRuntime()
+        var scheduled: [TimeInterval] = []
+        runtime._test_recoveryScheduled = { scheduled.append($0) }
+        let failure = ClaudeWebAPIFetcher.FetchError.cookieAccessDenied(browser: "Safari")
+        runtime.providerDidFail(context: context, provider: .claude, error: failure)
+        runtime.providerDidFail(context: context, provider: .claude, error: failure)
+        #expect(scheduled == [15])
+        runtime.providerDidRefresh(context: context, provider: .claude)
+        runtime.providerDidFail(context: context, provider: .claude, error: failure)
+        #expect(scheduled == [15, 15])
+        try context.settings.setProviderEnabled(
+            provider: .claude, metadata: #require(ProviderRegistry.shared.metadata[.claude]), enabled: false)
+        runtime.stop(context: context)
+        runtime.providerDidFail(context: context, provider: .claude, error: failure)
+        #expect(scheduled == [15, 15])
+    }
+
+    @Test
+    func `rate limiting postpones an already queued fast retry`() throws {
+        let (context, root) = try self.makeContext()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let runtime = ClaudeProviderRuntime()
+        var scheduled: [TimeInterval] = []
+        runtime._test_recoveryScheduled = { scheduled.append($0) }
+        runtime.providerDidFail(
+            context: context, provider: .claude, error: ClaudeWebAPIFetcher.FetchError.noSessionKeyFound)
+        runtime.providerDidFail(
+            context: context,
+            provider: .claude,
+            error: ClaudeWebAPIFetcher.FetchError.serverError(statusCode: 429))
+        #expect(scheduled == [15, 300])
+        runtime.providerDidFail(
+            context: context, provider: .claude, error: ClaudeWebAPIFetcher.FetchError.noSessionKeyFound)
+        #expect(scheduled == [15, 300])
+        runtime.stop(context: context)
+    }
+
+    @Test
+    func `recovery runs in background and progresses without a normal refresh timer`() async throws {
+        let (context, root) = try self.makeContext()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let runtime = ClaudeProviderRuntime()
+        var scheduled: [TimeInterval] = []
+        var refreshes = 0
+        runtime._test_recoveryScheduled = { scheduled.append($0) }
+        runtime._test_recoverySleep = { _ in }
+        runtime._test_recoveryRefresh = {
+            #expect(ProviderInteractionContext.current == .background)
+            refreshes += 1
+        }
+        let failure = ClaudeWebAPIFetcher.FetchError.noSessionKeyFound
+        runtime.providerDidFail(context: context, provider: .claude, error: failure)
+        for _ in 0..<100 where refreshes == 0 {
+            await Task.yield()
+        }
+        #expect(refreshes == 1)
+        runtime.providerDidFail(context: context, provider: .claude, error: failure)
+        #expect(scheduled == [15, 30])
+        runtime.stop(context: context)
+    }
+
+    @Test
+    func `switching away from web cancels pending recovery`() throws {
+        let (context, root) = try self.makeContext()
+        defer { try? FileManager.default.removeItem(at: root) }
+        let runtime = ClaudeProviderRuntime()
+        var scheduled: [TimeInterval] = []
+        runtime._test_recoveryScheduled = { scheduled.append($0) }
+        runtime.providerDidFail(
+            context: context, provider: .claude, error: ClaudeWebAPIFetcher.FetchError.noSessionKeyFound)
+        context.settings.claudeUsageDataSource = .oauth
+        runtime.settingsDidChange(context: context)
+        runtime.providerDidFail(
+            context: context, provider: .claude, error: ClaudeWebAPIFetcher.FetchError.noSessionKeyFound)
+        #expect(scheduled == [15])
+        runtime.stop(context: context)
+    }
+
+    @Test
+    func `Korean messages separate permission failures from missing login`() {
+        CodexBarLocalizationOverride.$appLanguage.withValue("ko") {
+            let permission = UsageStore.claudeWebFailureMessage(
+                ClaudeWebAPIFetcher.FetchError.cookieAccessDenied(browser: "Safari"))
+            let login = UsageStore.claudeWebFailureMessage(ClaudeWebAPIFetcher.FetchError.noSessionKeyFound)
+            #expect(permission.contains("접근 권한 필요"))
